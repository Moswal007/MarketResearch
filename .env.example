# opencode.ai/zen (OpenAI-compatible free-tier gateway) credentials
API_BASE_URL=
API_KEY=
MODEL=

# Set to true to run CompetitorAnalysis against deterministic sample data instead
# of searching/scraping real Facebook pages (useful for demos or offline testing).
USE_MOCK_DATA=

# Hours a product/region result is cached before CompetitorAnalysis re-queries.
CACHE_TTL_HOURS=

# Google Cloud service account JSON key (Places API (New) - the source of
# Google ratings/rating counts). Leave unset to fall back to a best-effort,
# frequently-blocked scrape of google.com/search instead.
GOOGLE_SERVICE_ACCOUNT_FILE=
# Or paste the key file's JSON contents on one line instead (e.g. on Vercel)
GOOGLE_SERVICE_ACCOUNT_JSON=
# Google Custom Search JSON API key + Programmable Search Engine ID (cx), used to
# find Facebook Pages (profile picture, description, followers) via Google's
# index. Leave unset to fall back to the DuckDuckGo + direct-fetch scrape.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=



# Meta Graph API token for an app approved for "Page Public Metadata Access"
# (app token format: APP_ID|APP_SECRET). When set, Facebook Pages' followers,
# category and description come straight from Meta instead of Google's index.
META_ACCESS_TOKEN=
# META_GRAPH_VERSION=v23.0
